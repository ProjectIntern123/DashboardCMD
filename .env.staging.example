# ==============================================================================
# HARTEK CMD Office Command Center - Staging Environment Configuration Template
# COPY TO: .env (in staging directory root or backend/.env and frontend/.env)
# NEVER commit populated credentials or production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT & EMAIL ISOLATION (MANDATORY FAIL-CLOSED GUARDS)
# ------------------------------------------------------------------------------
APP_ENV=staging
DEPLOY_ENV=staging
STAGING=true

# CRITICAL EMAIL KILL SWITCH: Preempts all DB settings and blocks transporter creation
DISABLE_OUTBOUND_EMAILS=true
ALLOW_OUTBOUND_EMAILS=false
ENABLE_STAGING_OUTBOUND_EMAILS=false

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (STRICTLY ISOLATED STAGING DATABASE)
# Must connect to dedicated staging database; NEVER use production database credentials!
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://cmd_staging:PLACEHOLDER_STAGING_DB_PASSWORD@127.0.0.1:5432/cmd_staging?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION SECURITY (DEDICATED STAGING SECRETS)
# Generate distinct, cryptographically random 64-character hex strings for staging
# ------------------------------------------------------------------------------
JWT_SECRET="PLACEHOLDER_GENERATE_UNIQUE_64_CHAR_HEX_STAGING_JWT_SECRET"
JWT_REFRESH_SECRET="PLACEHOLDER_GENERATE_UNIQUE_64_CHAR_HEX_STAGING_REFRESH_SECRET"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Set to "true" when serving staging over HTTPS behind Nginx reverse proxy
SECURE_COOKIES="true"

# ------------------------------------------------------------------------------
# 4. NETWORK & APPLICATION PORT BINDINGS
# ------------------------------------------------------------------------------
PORT=4001
HOST="127.0.0.1"
FRONTEND_PORT=3001
FRONTEND_URL="https://staging.cmd.hartek.com"

# Server-Side Rendering (SSR) API Target (Used by Next.js server components)
BACKEND_URL="http://127.0.0.1:4001"

# Browser Client-Side API Base Path (Relative path resolved by Nginx reverse proxy)
NEXT_PUBLIC_API_URL="/api"

# ------------------------------------------------------------------------------
# 5. MOCK SMTP CONFIGURATION (LOCAL MAIL TRAP / SANDBOX ONLY)
# Points to local mock mail catcher (e.g. MailHog / Inbucket on port 1025).
# NEVER configure real Office 365 or production SMTP credentials here!
# ------------------------------------------------------------------------------
SMTP_HOST="127.0.0.1"
SMTP_PORT=1025
SMTP_USERNAME="mock_staging_user"
SMTP_PASSWORD="mock_staging_password"

# ------------------------------------------------------------------------------
# 6. EXTERNAL API KEYS (OPTIONAL SANDBOX QUOTAS)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
