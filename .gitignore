# Dependencies
node_modules/
/backend/node_modules/
/frontend/node_modules/

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging
.env.staging.local
*.env.staging
/backend/.env
/backend/.env.staging
/frontend/.env
/frontend/.env.staging

# Explicitly preserve example/template files
!.env.example
!.env.staging.example
!/backend/.env.example
!/backend/.env.staging.example

# Build outputs
/backend/dist/
/backend/dist.*/
/frontend/.next/
/frontend/.next.*/
/frontend/out/
/frontend/build/

# IDE and System Files
.DS_Store
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# TypeScript
*.tsbuildinfo
/frontend/next-env.d.ts

# Testing
/coverage/

# Agent Scratch directories
/scratch/
backups/
/backups/

# Deployment and release metadata
.releases/
.prev-deployed-commit
.current-deployed-commit
.prev-staging-commit
