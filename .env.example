# PostgreSQL Database connection URL
DATABASE_URL="postgresql://cmd_office:root123@localhost:5432/database_name?schema=public"

# JWT Auth configuration
JWT_SECRET="your_jwt_access_token_secret_key"
JWT_REFRESH_SECRET="your_jwt_refresh_token_secret_key"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Cookie Security (true for production HTTPS, false for localhost HTTP development)
SECURE_COOKIES="false"

# AI extraction key (Claude Sonnet 3.5 API)
ANTHROPIC_API_KEY=""

# Application Port
PORT=4000

# Next.js API Base URL (Optional - Comment out or leave blank to automatically resolve the API URL dynamically)
# NEXT_PUBLIC_API_URL="http://localhost:4000/api"

